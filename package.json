{
  "name": "amvelt-trace-monorepo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Amvelt TRACE - The living codebase map for humans and AI agents",
  "author": "Anubhav Mishra",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "node ./scripts/lint.js",
    "test": "vitest run tests/unit",
    "test:fixtures": "vitest run tests/fixtures",
    "test:all": "vitest run",
    "dogfood": "node ./scripts/dogfood.js",
    "check:hygiene": "node ./scripts/check-package-hygiene.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "tsup": "^8.3.5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
